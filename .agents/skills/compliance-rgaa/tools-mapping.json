    "jest_setup": {
      "description": "Integration with Jest test suite",
      "config_file": "jest.setup.js",
      "code": "import { axe, toHaveNoViolations } from 'jest-axe';\nexpect.extend(toHaveNoViolations);\n\ntest('button component should have no accessibility violations', async () => {\n  const { container } = render(<Button>Click me</Button>);\n  const results = await axe(container);\n  expect(results).toHaveNoViolations();\n});"
    },
    "github_actions_ci": {
      "description": "GitHub Actions workflow for pa11y",
      "config_file": ".github/workflows/accessibility.yml",
      "code": "name: Accessibility Tests\non: [push, pull_request]\njobs:\n  a11y:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v3\n      - uses: actions/setup-node@v3\n        with:\n          node-version: '18'\n      - run: npm install pa11y\n      - run: npm run build\n      - run: pa11y --standard WCAG2AA http://localhost:3000\n      - run: pa11y --json > a11y-report.json\n      - uses: actions/upload-artifact@v3\n        with:\n          name: accessibility-report\n          path: a11y-report.json"
    },
    "gitlab_ci": {
      "description": "GitLab CI pipeline for axe-core",
      "config_file": ".gitlab-ci.yml",
      "code": "accessibility_test:\n  image: node:18\n  script:\n    - npm install --save-dev axe-core axe-puppeteer\n    - npm run build\n    - node scripts/axe-scan.js\n  artifacts:\n    reports:\n      accessibility: axe-report.json\n  allow_failure: false"
    },
    "jenkins_pipeline": {
      "description": "Jenkins pipeline integration",
      "config_file": "Jenkinsfile",
      "code": "pipeline {\n  agent any\n  stages {\n    stage('Test') {\n      steps {\n        sh 'npm install'\n        sh 'npm run build'\n      }\n    }\n    stage('Accessibility') {\n      steps {\n        sh 'npm install --save-dev pa11y pa11y-ci'\n        sh 'pa11y-ci || exit 1'\n      }\n      post {\n        always {\n          junit 'a11y-results.xml'\n          publishHTML([\n            reportDir: 'reports',\n            reportFiles: 'a11y-report.html',\n            reportName: 'Accessibility Report'\n          ])\n        }\n      }\n    }\n  }\n}"
    },
    "playwright_test": {
      "description": "Playwright E2E with axe-core",
      "config_file": "tests/a11y.spec.ts",
      "code": "import { test, expect } from '@playwright/test';\nimport { injectAxe, getViolations } from 'axe-playwright';\n\ntest('homepage should not have accessibility violations', async ({ page }) => {\n  await page.goto('http://localhost:3000');\n  await injectAxe(page);\n  const violations = await getViolations(page);\n  expect(violations).toEqual([]);\n});"
    },
    "cypress_integration": {
      "description": "Cypress E2E with axe",
      "config_file": "cypress/e2e/accessibility.cy.js",
      "code": "import 'cypress-axe';\n\ndescribe('Accessibility Tests', () => {\n  it('should not have accessibility violations on homepage', () => {\n    cy.visit('http://localhost:3000');\n    cy.injectAxe();\n    cy.checkA11y(null, {\n      runOnly: {\n        type: 'tag',\n        values: ['wcag2aa']\n      }\n    });\n  });\n});"
    },
    "npm_scripts": {
      "description": "NPM scripts for easy CLI access",
      "config_file": "package.json",
      "code": "\"scripts\": {\n  \"a11y:test\": \"jest --testPathPattern=a11y\",\n  \"a11y:scan\": \"pa11y https://localhost:3000\",\n  \"a11y:lighthouse\": \"lighthouse https://localhost:3000 --only-categories=accessibility\",\n  \"a11y:full\": \"npm run a11y:test && npm run a11y:scan && npm run a11y:lighthouse\",\n  \"a11y:ci\": \"pa11y https://localhost:3000 --json > a11y.json\"\n}"
    },
    "custom_script": {
      "description": "Custom Node.js script for batch scanning",
      "config_file": "scripts/scan-a11y.js",
      "code": "const axe = require('axe-core');\nconst puppeteer = require('puppeteer');\nconst fs = require('fs');\n\n(async () => {\n  const browser = await puppeteer.launch();\n  const page = await browser.newPage();\n  await page.goto('http://localhost:3000');\n  await page.addScriptTag({ path: require.resolve('axe-core') });\n  const results = await page.evaluate(() => {\n    return new Promise((resolve) => {\n      window.axe.run((error, results) => {\n        if (error) throw error;\n        resolve(results);\n      });\n    });\n  });\n  fs.writeFileSync('axe-results.json', JSON.stringify(results, null, 2));\n  console.log(`Found ${results.violations.length} violations`);\n  await browser.close();\n})();\n"
    }
