  "tool_selection_guide": {
    "decision_matrix": [
      {
        "scenario": "Quick local development testing",
        "recommended_tools": ["axe-core", "jest-axe"],
        "rationale": "Fast, free, tightly integrated into development workflow"
      },
      {
        "scenario": "Unit testing React components",
        "recommended_tools": ["jest-axe", "axe-core"],
        "rationale": "Direct Jest integration, perfect for component libraries"
      },
      {
        "scenario": "CI/CD pipeline automation",
        "recommended_tools": ["axe-core", "pa11y", "lighthouse"],
        "rationale": "CLI-based, scriptable, return proper exit codes"
      },
      {
        "scenario": "Visual interface for developers",
        "recommended_tools": ["axe-devtools", "accessibility-insights"],
        "rationale": "Browser extensions with excellent UX"
      },
      {
        "scenario": "Contrast testing specialist",
        "recommended_tools": ["color-contrast-analyzer"],
        "rationale": "Dedicated tool, most accurate for 1.4.x rules"
      },
      {
        "scenario": "Interactive/SPA testing",
        "recommended_tools": ["magsafe-validator", "axe-core", "jest-axe"],
        "rationale": "Handle JavaScript-rendered content"
      },
      {
        "scenario": "Full-page audit reports",
