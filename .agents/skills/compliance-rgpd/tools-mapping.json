{
  "version": "1.0",
  "description": "Data-driven tools with validation patterns",
  "last_updated": "2026-03-25",
  "tools": {
    "privacy-analyzer": {
      "name": "PRIVACY ANALYZER",
      "category": "automated",
      "automation_level": "fully_automated",
      "validation_patterns": [
        {
          "applies_to_tests": ["1.1.1"],
          "type": "regex_match",
          "pattern": "privacy.*policy",
          "expect": "present",
          "error_message": "Privacy policy missing",
          "severity": "CRITICAL"
        }
      ]
    },
    "security-validator": {
      "name": "SECURITY VALIDATOR",
      "category": "automated",
      "automation_level": "fully_automated",
      "validation_patterns": [
        {
          "applies_to_tests": ["3.1.1"],
          "type": "url_check",
          "must_start_with": "https://",
          "error_message": "HTTPS not enforced",
          "severity": "CRITICAL"
        }
      ]
    }
  }
}
